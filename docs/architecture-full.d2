direction: up

title: "Ace Archive Architecture" {
  shape: text
  near: top-center
  style: {
    font-size: 40
  }
}

legend: "Legend" {
  user: "User" {
    shape: "person"
  }

  compute: "Compute" {
    shape: "queue"
  }

  storage: "Storage" {
    shape: "cylinder"
  }

  service: "Service" {
    shape: "cloud"
  }

  repository: "Source\nRepository" {
    shape: "package"
  }
}

visitor: "Visitor" {
  shape: "person"
}

vps: VPS {
  omeka: "Omeka S" {
    shape: "queue"
  }

  mysql: "MySQL" {
    shape: "cylinder"
  }

  drive: "Block\nStorage" {
    shape: "cylinder"
  }

  connector: "Omeka\nData\nConnector" {
    shape: "queue"
  }

  proxy: "Caddy\nReverse\nProxy" {
    shape: "queue"
  }

  backups: "Backup\nScript" {
    shape: "queue"
  }

  timer: "systemd\nTimer" {
    shape: "queue"
  }

  umami: "Umami\nAnalytics" {
    shape: "queue"
  }

  pg: "Postgres" {
    shape: "cylinder"
  }
}

cf: "Cloudflare" {
  cdn: "CDN" {
    shape: "cloud"
  }

  cache: "Cache" {
    shape: "cloud"
  }

  proxy: "Media\nProxy" {
    shape: "queue"
  }

  site: "Site\nProxy" {
    shape: "queue"
  }

  backups: "Backups\nBucket" {
    shape: "cylinder"
  }
}

github: "GitHub" {
  services: "Services\nRepository" {
    shape: "package"
  }

  deployment: "Omeka\nDeployment\nRepository" {
    shape: "package"
  }

  site: "Static\nSite\nRepository" {
    shape: "package"
  }
}

visitor -> cf.site: "Visit Site"
visitor -> cf.proxy: "View File"
visitor -> vps.proxy: "Send Analytics"

github.deployment -> vps.omeka: "Deploy"
github.services -> vps.connector: "Deploy"
github.services -> cf.proxy: "Deploy"
github.site -> cf.site: "Deploy"
github.site -> cf.cdn: "Deploy"
github.site -> vps.proxy: "Fetch Data"

vps.omeka -> vps.mysql: "Store Data"
vps.omeka -> vps.drive: "Store Files"
vps.connector -> vps.omeka: "Call API"
vps.proxy -> vps.omeka: "Forward"
vps.proxy -> vps.connector: "Forward"
vps.proxy -> vps.umami: "Forward"
vps.backups -> cf.backups: "Store"
vps.timer -> vps.backups: "Trigger"
vps.backups -> vps.mysql: "Fetch Data"
vps.backups -> vps.drive: "Fetch Files"
vps.umami -> vps.pg: "Store Analytics"

cf.proxy -> vps.proxy: "Forward"
cf.proxy -> cf.cache: "Cache"
cf.backups -> cf.backups: "Delete"
cf.site -> cf.cdn: "Fetch Assets"
